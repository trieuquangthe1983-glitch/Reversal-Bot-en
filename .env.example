# =============================================================================
# License server config
# =============================================================================
# Copy to .env and fill in. NEVER commit .env to git.

# REQUIRED: long random string used to gate /admin/* endpoints
LICENSE_ADMIN_TOKEN=

# OPTIONAL: PEM contents of the private key inline (preferred for cloud deploy).
# If unset, server reads ./state/master_private.pem instead.
# Example:
#   MASTER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAw...\n-----END PRIVATE KEY-----"
MASTER_PRIVATE_KEY=

# OPTIONAL: override the payment wallet (defaults to the one in blockchain.py)
LICENSE_PAYMENT_WALLET=0xFdE5bE00bA5db63a93abf7922ee831dB62257550

# OPTIONAL: tune anti-fraud
LICENSE_RATE_LIMIT_FAILURES=5
LICENSE_RATE_LIMIT_WINDOW_MINUTES=60
LICENSE_MIN_CONFIRMATIONS=12

# OPTIONAL: where SQLite lives
LICENSE_STATE_DIR=state
LICENSE_DB_PATH=state/licenses.db
